# Exporte estas variáveis no ambiente; o projeto não carrega .env automaticamente.

# Django
# Use DJANGO_DEBUG=True apenas no desenvolvimento local.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Gere uma chave aleatória somente no ambiente local ou no gerenciador de segredos.
# Em produção, DJANGO_DEBUG deve ser False, com chave aleatória e hosts explícitos:
# DJANGO_ALLOWED_HOSTS=seu-dominio.example,www.seu-dominio.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.example,https://www.seu-dominio.example

# E-mail
# Em desenvolvimento, o backend console é escolhido automaticamente.
# Para enviar e-mails reais localmente, descomente a variável abaixo.
# Em produção, o backend SMTP é escolhido automaticamente. Não configure
# o backend console quando DJANGO_DEBUG=False.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_EMAIL=contact@example.com

# Ative a verificação em duas etapas e gere uma senha de app; configure-a
# somente no gerenciador de segredos do provedor, nunca neste arquivo.
